# The default fake adapter is deterministic and requires no secret.
ASSEMBLY_PORT=4317
ASSEMBLY_DB_PATH=data/naetia-council.sqlite
MODEL_ADAPTER=fake
FAKE_MODEL_DELAY_MS=200

# Optional real-model mode through the locally authenticated Codex CLI.
# Keep MODEL_ADAPTER=fake for deterministic development and tests.
# MODEL_ADAPTER=codex-cli
# CODEX_CLI_PATH=/absolute/path/to/codex
# CODEX_HOME=/home/you/.codex
# CODEX_MODEL=
# CODEX_RUN_TIMEOUT_MS=180000
# CODEX_REVEAL_DELAY_MS=40

# Optional OpenAI-compatible chat provider (for example llama.cpp on a compute node).
# Keep the full endpoint, model alias and key outside Git.
# MODEL_ADAPTER=openai-compatible
# OPENAI_COMPATIBLE_CHAT_URL=http://compute-host:8003/v1/chat/completions
# OPENAI_COMPATIBLE_MODEL=local-council-model
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MAX_TOKENS=512
# OPENAI_COMPATIBLE_ENABLE_THINKING=false
# OPENAI_COMPATIBLE_RUN_TIMEOUT_MS=180000
# OPENAI_COMPATIBLE_REVEAL_DELAY_MS=40
