{
  "name": "@naetia/assemblyd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dependencies": "pnpm --filter @naetia/assembly-domain --filter @naetia/assembly-protocol build",
    "dev": "pnpm run build:dependencies && pnpm run build && tsx watch src/server.ts",
    "lint": "eslint src tests --max-warnings=0",
    "start": "node dist/server.js",
    "test": "pnpm run build:dependencies && pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@naetia/assembly-domain": "workspace:*",
    "@naetia/assembly-protocol": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
